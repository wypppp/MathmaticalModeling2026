+def timed(choices, starts):
+    ordered = sorted(choices, key=lambda k: (starts[k[0]], k[0]))
+    plans = {i: (cases[b][0][0], starts[b], 0) for i, (b, k) in enumerate(ordered)}
+    stops = {i: details[key]["stops"] for i, key in enumerate(ordered)}
